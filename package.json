{
  "name": "secure-ci-cd-pipeline-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo Node.js app + secure CI/CD pipeline with GitHub Actions & Snyk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<owner>/<repo>.git"
  },
  "bugs": {
    "url": "https://github.com/<owner>/<repo>/issues"
  },
  "homepage": "https://github.com/<owner>/<repo>#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "audit": "npm audit --audit-level=high",
    "snyk:oss": "snyk test --severity-threshold=high",
    "snyk:code": "snyk code test --severity-threshold=high",
    "snyk:container": "snyk container test secure-ci-cd-pipeline-demo:local --severity-threshold=high --file=Dockerfile"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.0.0",
    "supertest": "^7.1.4"
  }
}
